<Window x:Class="etch_ui.InterlockSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HMI 설정 (인터락 · 레시피)"
        Height="720"
        Width="520"
        MinHeight="560"
        MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontFamily="{StaticResource HmiFont}"
        Background="{StaticResource HmiCanvasBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="HMI 설정 (관리자)" FontSize="20" FontWeight="Bold" Foreground="{StaticResource HmiTextPrimaryBrush}"/>
            <TextBlock Text="appsettings.json — 인터락 허용 범위·압력 환산·연결 (저장 후 즉시 반영)"
                       Style="{StaticResource HmiCardSubtitle}" TextWrapping="Wrap"/>
            <TextBlock x:Name="TxtPath" Style="{StaticResource HmiCaption}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource HmiCard}" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="연결" FontWeight="SemiBold" Foreground="{StaticResource HmiTextPrimaryBrush}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Flask URL" Style="{StaticResource HmiCaption}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtFlaskUrl" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="ADS 포트" Style="{StaticResource HmiCaption}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtAdsPort" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="시뮬 기본 허용" Style="{StaticResource HmiCaption}" VerticalAlignment="Center"/>
                            <CheckBox Grid.Row="2" Grid.Column="1" x:Name="ChkSimEnabled" Content="SimulationEnabled" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource HmiCard}" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="인터락 허용 범위 (공정 Start)" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="압력 하한" Style="{StaticResource HmiCaption}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtPressureMin" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="mTorr" VerticalAlignment="Center" FontSize="11" Foreground="#64748B"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="압력 상한" Style="{StaticResource HmiCaption}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtPressureMax" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="mTorr" VerticalAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="진동 상한" Style="{StaticResource HmiCaption}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtVibMax" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="g" VerticalAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="온도 범위" Style="{StaticResource HmiCaption}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBox x:Name="TxtTempMin" Width="80" Height="32" VerticalContentAlignment="Center"/>
                                <TextBlock Text="~" VerticalAlignment="Center" Margin="6,0"/>
                                <TextBox x:Name="TxtTempMax" Width="80" Height="32" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="℃" VerticalAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="습도 범위" Style="{StaticResource HmiCaption}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                                <TextBox x:Name="TxtHumiMin" Width="80" Height="32" VerticalContentAlignment="Center"/>
                                <TextBlock Text="~" VerticalAlignment="Center" Margin="6,0"/>
                                <TextBox x:Name="TxtHumiMax" Width="80" Height="32" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="%" VerticalAlignment="Center" FontSize="11"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource HmiCard}" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="공정 레시피 (XML + tick)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="Recipes/default.process.xml · 다음 Start부터 tick·PM 순서 반영" Style="{StaticResource HmiCardSubtitle}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="레시피 이름" Style="{StaticResource HmiCaption}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtRecipeName" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="식각 PM 순서" Style="{StaticResource HmiCaption}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtEtchPmSeq" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,6"
                                     ToolTip="예: PM2,PM3,PM4 또는 PM2→PM4→PM3"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="XML 경로" Style="{StaticResource HmiCaption}" VerticalAlignment="Top" Margin="0,6,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtRecipeXmlPath" TextWrapping="Wrap" FontSize="11" Foreground="#64748B" Margin="0,6,0,0"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="XML 불러오기" Style="{StaticResource HmiSecondaryButton}" Margin="0,0,8,0" Click="BtnLoadXml_Click"/>
                            <Button Content="XML보내기" Style="{StaticResource HmiSecondaryButton}" Click="BtnExportXml_Click"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="48"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Etch (PM2~4)" Style="{StaticResource HmiCaption}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtEtchTicks" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="tick" VerticalAlignment="Center" FontSize="11" Foreground="#64748B"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Strip (PM1)" Style="{StaticResource HmiCaption}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtStripTicks" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="tick" VerticalAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Aligner" Style="{StaticResource HmiCaption}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtAlignTicks" Height="32" VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="tick" VerticalAlignment="Center" FontSize="11"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource HmiCard}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="압력 환산 (PLC Raw → mTorr)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="차트·센서 표시용. 인터락 범위와 별도입니다." Style="{StaticResource HmiCardSubtitle}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Raw Min / Max" Style="{StaticResource HmiCaption}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBox x:Name="TxtRawMin" Width="72" Height="32" VerticalContentAlignment="Center"/>
                                <TextBlock Text="/" VerticalAlignment="Center" Margin="6,0"/>
                                <TextBox x:Name="TxtRawMax" Width="72" Height="32" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="mTorr @ RawMin" Style="{StaticResource HmiCaption}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtMtorrAtMin" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="mTorr @ RawMax" Style="{StaticResource HmiCaption}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtMtorrAtMax" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="소수 자릿수" Style="{StaticResource HmiCaption}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtDecimals" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,6"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2">
            <TextBlock x:Name="TxtMsg" Foreground="#DC2626" TextWrapping="Wrap" MinHeight="18" Margin="0,0,0,10" FontSize="13"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="기본값 복원" Style="{StaticResource HmiSecondaryButton}" Margin="0,0,8,0" Click="BtnDefaults_Click"/>
                <Button Content="저장" Style="{StaticResource HmiPrimaryButton}" Margin="0,0,8,0" Click="BtnSave_Click" IsDefault="True"/>
                <Button Content="닫기" Style="{StaticResource HmiSecondaryButton}" IsCancel="True" Click="BtnClose_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
