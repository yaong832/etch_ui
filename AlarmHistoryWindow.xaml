<Window x:Class="etch_ui.AlarmHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="알람 이력 (SQLite)"
        Height="520"
        Width="860"
        MinHeight="400"
        MinWidth="700"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource HmiFont}"
        Background="{StaticResource HmiCanvasBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="알람 이력" FontSize="20" FontWeight="Bold" Foreground="{StaticResource HmiTextPrimaryBrush}"/>
            <TextBlock Text="SQLite alarm_history — 발생·해제 시각 (최근 200건)"
                       Style="{StaticResource HmiCardSubtitle}"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource HmiCard}" Padding="10">
            <DataGrid x:Name="GrdAlarms" Style="{StaticResource HmiDataGrid}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="상태" Binding="{Binding StatusDisplay}" Width="56"/>
                    <DataGridTextColumn Header="코드" Binding="{Binding AlarmCode}" Width="56"/>
                    <DataGridTextColumn Header="요약" Binding="{Binding SummaryDisplay}" Width="120"/>
                    <DataGridTextColumn Header="발생" Binding="{Binding OccurredAtDisplay}" Width="150"/>
                    <DataGridTextColumn Header="해제" Binding="{Binding ResolvedAtDisplay}" Width="150"/>
                    <DataGridTextColumn Header="해제자" Binding="{Binding ResolvedBy}" Width="80"/>
                    <DataGridTextColumn Header="비고" Binding="{Binding Note}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="새로고침" Style="{StaticResource HmiSecondaryButton}" Margin="0,0,8,0" Click="BtnRefresh_Click"/>
            <Button Content="닫기" Style="{StaticResource HmiPrimaryButton}" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
