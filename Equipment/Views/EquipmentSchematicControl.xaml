                            <Rectangle x:Name="BladeRailTop" Canvas.Left="170" Canvas.Top="17" Width="56" Height="7"/>
                            <Rectangle x:Name="BladeRailBottom" Canvas.Left="170" Canvas.Top="28" Width="56" Height="7" Visibility="Collapsed"/>
                            <Rectangle x:Name="BladeCenterPad" Canvas.Left="212" Canvas.Top="14" Width="24" Height="13" Opacity="0.95"/>
                            <Rectangle x:Name="BladeTipTop" Canvas.Left="218" Canvas.Top="14" Width="24" Height="13"/>
                            <Rectangle x:Name="BladeTipBottom" Canvas.Left="218" Canvas.Top="28" Width="24" Height="13" Visibility="Collapsed"/>
                            <Rectangle x:Name="BladeProngTopL" Canvas.Left="225" Canvas.Top="16" Width="2.4" Height="9"/>
                            <Rectangle x:Name="BladeProngTopR" Canvas.Left="235" Canvas.Top="16" Width="2.4" Height="9"/>
                            <Rectangle x:Name="BladeSlotA" Canvas.Left="98" Canvas.Top="13" Width="16" Height="16" Visibility="Collapsed"/>
                            <Rectangle x:Name="BladeSlotB" Canvas.Left="228" Canvas.Top="13" Width="16" Height="16" Visibility="Collapsed"/>
