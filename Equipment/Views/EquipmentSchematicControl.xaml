                            <Rectangle x:Name="BladeTipBack" Canvas.Left="98" Canvas.Top="14" Width="24" Height="13" Visibility="Collapsed"/>
                            <Rectangle x:Name="BladeProngFrontL" Canvas.Left="225" Canvas.Top="16" Width="2.4" Height="9" Visibility="Collapsed"/>
