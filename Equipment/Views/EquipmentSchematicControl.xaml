<UserControl x:Class="etch_ui.Equipment.Views.EquipmentSchematicControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:etch_ui.Equipment.Converters"
             xmlns:layout="clr-namespace:etch_ui.Equipment.Layout"
             MinHeight="300">
    <UserControl.Resources>
        <conv:BoolToDoorBrushConverter x:Key="BoolToDoorBrush"/>
        <conv:BoolToDoorTextConverter x:Key="BoolToDoorText"/>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>
    <Border Background="#E8ECF1" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1" Padding="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="4,2,4,6">
                <TextBlock Text="장비 레이아웃 (실시간)" FontWeight="SemiBold" FontSize="12" Foreground="#1F2937"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding ServoHint}" FontSize="11" Foreground="#6B7280"/>
            </DockPanel>
            <Viewbox Grid.Row="1" Stretch="Uniform">
                <Canvas x:Name="LayoutCanvas"
                        Width="{x:Static layout:EquipmentLayoutMetrics.DesignWidth}"
                        Height="{x:Static layout:EquipmentLayoutMetrics.DesignHeight}"
                        Background="#F1F5F9">
                    <Border x:Name="LoadLockBox" Width="88" Height="88" CornerRadius="6"
                            Background="#FFFFFF" BorderBrush="#94A3B8" BorderThickness="2">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="Load Lock" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <Ellipse Width="14" Height="14" Margin="0,6,0,0"
                                     Fill="{Binding LoadLockDoorClosed, Converter={StaticResource BoolToDoorBrush}}"/>
                            <TextBlock FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"
                                       Text="{Binding LoadLockDoorClosed, Converter={StaticResource BoolToDoorText}}"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="ChamberABox" Width="118" Height="88" CornerRadius="6"
                            Background="#FFFFFF" BorderBrush="#64748B" BorderThickness="2">
                        <Grid>
                            <Rectangle Height="8" VerticalAlignment="Top" Fill="{Binding ChamberALampBrush}"/>
                            <StackPanel VerticalAlignment="Center" Margin="0,10,0,0">
                                <TextBlock Text="Chamber A" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"/>
                                <Ellipse Width="22" Height="22" Margin="0,6,0,0"
                                         Visibility="{Binding ChamberAHasWafer, Converter={StaticResource BoolVis}}"
                                         Fill="{Binding WaferBrush}" Stroke="#B45309" StrokeThickness="1.5"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="ChamberBBox" Width="118" Height="88" CornerRadius="6"
                            Background="#FFFFFF" BorderBrush="#64748B" BorderThickness="2">
                        <Grid>
                            <Rectangle Height="8" VerticalAlignment="Top" Fill="{Binding ChamberBLampBrush}"/>
                            <StackPanel VerticalAlignment="Center" Margin="0,10,0,0">
                                <TextBlock Text="Chamber B" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"/>
                                <Ellipse Width="22" Height="22" Margin="0,6,0,0"
                                         Visibility="{Binding ChamberBHasWafer, Converter={StaticResource BoolVis}}"
                                         Fill="{Binding WaferBrush}" Stroke="#B45309" StrokeThickness="1.5"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="ChamberCBox" Width="118" Height="88" CornerRadius="6"
                            Background="#FFFFFF" BorderBrush="#64748B" BorderThickness="2">
                        <Grid>
                            <Rectangle Height="8" VerticalAlignment="Top" Fill="{Binding ChamberCLampBrush}"/>
                            <StackPanel VerticalAlignment="Center" Margin="0,10,0,0">
                                <TextBlock Text="Chamber C" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"/>
                                <Ellipse Width="22" Height="22" Margin="0,6,0,0"
                                         Visibility="{Binding ChamberCHasWafer, Converter={StaticResource BoolVis}}"
                                         Fill="{Binding WaferBrush}" Stroke="#B45309" StrokeThickness="1.5"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="FoupABox" Width="100" Height="72" CornerRadius="6"
                            Background="#E2E8F0" BorderBrush="#94A3B8" BorderThickness="1.5">
                        <TextBlock Text="FOUP A" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border x:Name="FoupBBox" Width="100" Height="72" CornerRadius="6"
                            Background="#E2E8F0" BorderBrush="#94A3B8" BorderThickness="1.5">
                        <TextBlock Text="FOUP B" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <Grid x:Name="TmHost" Width="84" Height="84">
                        <Grid.RenderTransform>
                            <RotateTransform x:Name="TmRotate" Angle="0" CenterX="42" CenterY="42"/>
                        </Grid.RenderTransform>
                        <Rectangle x:Name="BladeRect" Fill="#475569" RadiusX="3" RadiusY="3"
                                     Height="16" VerticalAlignment="Center" HorizontalAlignment="Left"
                                     Margin="42,34,0,34"/>
                        <Ellipse Width="84" Height="84" Fill="#3B82F6" Stroke="#1E40AF" StrokeThickness="2.5"/>
                        <TextBlock Text="TM" Foreground="White" FontWeight="Bold" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Ellipse x:Name="WaferOnBlade" Width="18" Height="18" Fill="{Binding WaferBrush}"
                                 Stroke="#B45309" HorizontalAlignment="Left" VerticalAlignment="Center"
                                 Margin="8,0,0,0" Visibility="Collapsed"/>
                    </Grid>

                    <TextBlock x:Name="TmLabel" Text="{Binding TmRegionLabel}"
                               FontSize="10" Foreground="#334155" FontWeight="SemiBold"/>
                </Canvas>
            </Viewbox>
        </Grid>
    </Border>
</UserControl>
