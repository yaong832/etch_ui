<UserControl x:Class="etch_ui.Equipment.Views.EquipmentDiagnosticsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="320">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/etch_ui;component/Resources/HmiTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolVis"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Padding="8,6" Background="#E2E8F0" BorderBrush="#94A3B8" BorderThickness="1" CornerRadius="6">
        <StackPanel>
            <TextBlock Text="{Binding RobotStatusSummary}" FontSize="11" FontWeight="Bold"
                       Foreground="#0F172A" TextWrapping="Wrap"/>
            <UniformGrid Columns="3" Margin="0,6,0,0">
                <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="5" Padding="6,4" Margin="0,0,4,0">
                    <TextBlock Text="{Binding VacuumBladeSummary}" FontSize="9" FontWeight="SemiBold"
                               Foreground="#075985" TextWrapping="Wrap"/>
                </Border>
                <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="5" Padding="6,4" Margin="0,0,4,0">
                    <TextBlock Text="{Binding EfemBladeSummary}" FontSize="9" FontWeight="SemiBold"
                               Foreground="#0F766E" TextWrapping="Wrap"/>
                </Border>
                <Border Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1" CornerRadius="5" Padding="6,4">
                    <TextBlock Text="{Binding TransferHoldSummary}" FontSize="9" FontWeight="Bold"
                               Foreground="#9A3412" TextWrapping="Wrap"/>
                </Border>
            </UniformGrid>
            <TextBlock Text="{Binding WaferFlowPipelineText}" FontSize="10" Foreground="#475569" Margin="0,8,0,0"
                       TextWrapping="Wrap"/>
            <Border Margin="0,8,0,0" Padding="8,5" CornerRadius="4"
                    Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1"
                    Visibility="{Binding SchedulerHoldActive, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding SchedulerStatusText}" FontSize="10" FontWeight="Bold" Foreground="#92400E"
                           TextWrapping="Wrap"/>
            </Border>
            <TextBlock Text="{Binding DualBladeDetailText}" FontSize="10" Foreground="#334155" Margin="0,8,0,0"
                       FontFamily="Consolas" TextWrapping="Wrap"/>
            <TextBlock Text="웨이퍼 타임라인" FontSize="10" FontWeight="SemiBold" Foreground="#475569" Margin="0,10,0,4"/>
            <ListBox ItemsSource="{Binding WaferTimeline}" MaxHeight="140" BorderThickness="0"
                     Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayText}" FontSize="9" FontFamily="Consolas"
                                   Foreground="#1E293B" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="웨이퍼 색: 밀색=공정전 · 황=가공중 · 녹=Etch완 · 파=Strip완" FontSize="9"
                       Foreground="#64748B" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</UserControl>
