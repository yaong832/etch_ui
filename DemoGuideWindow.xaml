<Window x:Class="etch_ui.DemoGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="데모 시나리오 (3분)"
        Height="380" Width="460"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource HmiFont}"
        Background="{StaticResource HmiCanvasBrush}">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="발표·검증용 데모 순서" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="시뮬 허용 ON · Flask 실행 권장" Style="{StaticResource HmiCardSubtitle}" Margin="0,8,0,14"/>
            <TextBlock TextWrapping="Wrap" LineHeight="22" FontSize="13">
                1. admin 로그인 → 시뮬 허용 ON<LineBreak/>
                2. Start → 가상 이송·공정 스텝·FOUP 잔량 확인<LineBreak/>
                3. Stop → Maint → 정비 도구(1틱) → 해제<LineBreak/>
                4. 설정에서 인터락/레시피 저장 → 이벤트 로그·Flask events 확인<LineBreak/>
                5. 브라우저: /api/etch/history · /api/etch/modules/latest
            </TextBlock>
            <Button Content="닫기" Style="{StaticResource HmiPrimaryButton}" Margin="0,20,0,0"
                    HorizontalAlignment="Right" IsCancel="True" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
