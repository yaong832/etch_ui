<Window x:Class="etch_ui.DemoGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="데모 시나리오 (3분)"
        Height="480" Width="520"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource HmiFont}"
        Background="{StaticResource HmiCanvasBrush}">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="발표·검증용 데모 순서" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="시뮬 허용 ON · Flask run_flask.bat 권장" Style="{StaticResource HmiCardSubtitle}" Margin="0,8,0,10"/>
            <TextBlock TextWrapping="Wrap" LineHeight="22" FontSize="13">
                <Bold>사전</Bold> Flask 실행 · admin 로그인<LineBreak/>
                <Bold>0:20</Bold> 시뮬 허용 ON → DEMO (시뮬)<LineBreak/>
                <Bold>0:40</Bold> (선택) 데모 진행 — 로그 5단계 자동<LineBreak/>
                <Bold>1:00</Bold> ▶ 시작 → RUNNING · 가상 이송·FOUP<LineBreak/>
                <Bold>2:00</Bold> AI 조언 · 공정 스텝 · 인터락 [데모]<LineBreak/>
                <Bold>2:20</Bold> 대시보드 → 모듈·레시피·AI 진단 탭<LineBreak/>
                <Bold>2:50</Bold> ■ 정지<LineBreak/>
                <LineBreak/>
                전체 체크·자동 검증: 발표용_데모_체크리스트.md
            </TextBlock>
            <Button Content="닫기" Style="{StaticResource HmiPrimaryButton}" Margin="0,16,0,0"
                    HorizontalAlignment="Right" IsCancel="True" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
