<UserControl x:Class="etch_ui.Controls.SparklineControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="72">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleBlock" Grid.Row="0" FontSize="11" Foreground="#6B7280" Margin="0,0,0,4"/>
        <Border Grid.Row="1" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
            <Canvas x:Name="PlotCanvas" SizeChanged="PlotCanvas_OnSizeChanged"/>
        </Border>
    </Grid>
</UserControl>
