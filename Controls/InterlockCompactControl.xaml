<UserControl x:Class="etch_ui.Controls.InterlockCompactControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:etch_ui.Controls"
             MinWidth="220">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/etch_ui;component/Resources/HmiTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <Border Style="{StaticResource HmiInfoBanner}" Background="#EEF2FF" BorderBrush="#C7D2FE" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="인터락 판정" FontWeight="SemiBold" Foreground="#1E3A8A" FontSize="11"/>
                <TextBlock Text="{Binding InterlockResultText}" Foreground="{Binding InterlockResultBrush}"
                           FontSize="14" FontWeight="Bold" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <TextBlock Text="{Binding InterlockPlcText}" FontWeight="SemiBold"
                   Foreground="{Binding InterlockPlcBrush}" FontSize="12" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding InterlockPressureText}" Margin="0,4,0,0" FontWeight="SemiBold"
                   Foreground="{Binding InterlockPressureBrush}" FontSize="11" TextWrapping="Wrap"/>
        <Border Style="{StaticResource HmiInfoBanner}" Background="#F0FDF4" BorderBrush="#86EFAC" Margin="0,10,0,0"
                ToolTip="{Binding AiEngineStatusHint}">
            <StackPanel>
                <DockPanel Margin="0,0,0,4">
                    <TextBlock Text="AI 조언" FontWeight="SemiBold" Foreground="#166534" FontSize="11"/>
                    <Border DockPanel.Dock="Right" Background="#DCFCE7" CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding AiEngineStatusText}" FontSize="10" FontWeight="Bold"
                                   Foreground="{Binding AiEngineStatusBrush}"/>
                    </Border>
                </DockPanel>
                <TextBlock Text="{Binding AiScoreText}" FontWeight="Bold" FontSize="12"
                           Foreground="{Binding AiScoreBrush}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding AiHintText}" TextWrapping="Wrap" Margin="0,4,0,0"
                           FontSize="11" Foreground="#374151" LineHeight="16" MaxHeight="48"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding AiPredictedAlarmText}" TextWrapping="Wrap" Margin="0,6,0,0"
                           FontSize="10" FontWeight="SemiBold" Foreground="#7C2D12" LineHeight="15"
                           MaxHeight="60" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>
        <Button x:Name="BtnOpenAiDetail" Content="↗ 인터락·AI 상세" Margin="0,8,0,0"
                Style="{StaticResource HmiSecondaryButton}" Padding="8,4" FontSize="11"
                ToolTip="레시피·인터락 전체·AI 근거·모듈 상태 분리 창"/>
        <TextBlock Text="공정 스텝" Style="{StaticResource HmiCaption}" Margin="0,10,0,4"/>
        <controls:ProcessStepLadderControl ActiveStepIndex="{Binding ProcessStepIndex}"
            IsWarningStep="{Binding ProcessStepWarning}"
            ActiveStepCaption="{Binding ProcessStepCaption}"
            StepDetailText="{Binding ProcessStepDetailText}"/>
    </StackPanel>
</UserControl>
