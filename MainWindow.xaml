<Window x:Class="etch_ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:controls="clr-namespace:etch_ui.Controls"
        xmlns:eq="clr-namespace:etch_ui.Equipment.Views"
        mc:Ignorable="d"
        Title="Etch Load Lock HMI"
        Height="900" Width="1320" MinHeight="640" MinWidth="1024"
        FontFamily="{StaticResource HmiFont}"
        Background="{StaticResource HmiCanvasBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="360"/>
            <RowDefinition Height="Auto" MinHeight="80" MaxHeight="160"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7.5*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1.6*"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Grid.ColumnSpan="3" Background="{StaticResource HmiHeaderBrush}"
                CornerRadius="12" Padding="16,14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="ETCH LOAD LOCK HMI" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Text="플라즈마 식각 · Load Lock / 챔버 모니터링" Foreground="White"
                                   FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                    <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="#1E293B" CornerRadius="8" Padding="10,6" Margin="0,0,8,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="사용자" Style="{StaticResource HmiStatusChipLabel}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding CurrentUserText}" Foreground="#6EE7B7" FontWeight="SemiBold" FontSize="13"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="BtnAppMenu" Content="메뉴 ▾" Style="{StaticResource HmiToolbarButton}"
                                Click="BtnAppMenu_Click" ToolTip="이벤트·알람·계정·관리">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="AppHeaderMenu" Style="{StaticResource HmiHeaderContextMenu}"
                                             ItemContainerStyle="{StaticResource HmiHeaderMenuItem}">
                                    <MenuItem Header="이벤트 로그" Click="BtnEventLog_Click"
                                              ToolTip="SQLite 운영 이벤트"/>
                                    <MenuItem Header="알람 이력" Click="BtnAlarmHistory_Click"
                                              ToolTip="알람 발생·해제 기록"/>
                                    <MenuItem Header="비밀번호 변경" Click="BtnChangePassword_Click"/>
                                    <Separator x:Name="MenuAdminSeparator"/>
                                    <MenuItem x:Name="MenuItemSettings" Header="설정 (관리자)" Click="BtnSettings_Click"
                                              ToolTip="인터락·압력·레시피 appsettings"/>
                                    <MenuItem x:Name="MenuItemUserManage" Header="사용자 관리" Click="BtnUserManage_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button x:Name="BtnLogout" Content="로그아웃" Style="{StaticResource HmiToolbarButton}"
                                Click="BtnLogout_Click"/>
                        <Button x:Name="BtnOpenFlask" Content="대시보드" Style="{StaticResource HmiToolbarButtonPrimary}"
                                Click="BtnOpenFlask_Click" ToolTip="Flask 웹 대시보드"/>
                    </WrapPanel>
                </DockPanel>
                <WrapPanel Grid.Row="1" Margin="0,12,0,0">
                    <Border Style="{StaticResource HmiStatusChip}" ToolTip="{Binding FlaskStatusHint}">
                        <StackPanel>
                            <TextBlock Text="Flask" Style="{StaticResource HmiStatusChipLabel}"/>
                            <TextBlock Text="{Binding FlaskStatusText}" Foreground="{Binding FlaskStatusBrush}"
                                       Style="{StaticResource HmiStatusChipValue}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource HmiStatusChip}">
                        <StackPanel>
                            <TextBlock Text="EtherCAT" Style="{StaticResource HmiStatusChipLabel}"/>
                            <TextBlock Text="{Binding PlcStatusText}" Foreground="{Binding PlcStatusBrush}"
                                       Style="{StaticResource HmiStatusChipValue}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource HmiStatusChip}">
                        <StackPanel>
                            <TextBlock Text="데이터" Style="{StaticResource HmiStatusChipLabel}"/>
                            <TextBlock Text="{Binding DataQualityText}" Foreground="{Binding DataQualityBrush}"
                                       Style="{StaticResource HmiStatusChipValue}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource HmiStatusChip}">
                        <StackPanel>
                            <TextBlock Text="갱신" Style="{StaticResource HmiStatusChipLabel}"/>
                            <TextBlock Text="{Binding LastUpdateText}" Style="{StaticResource HmiStatusChipValue}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource HmiStatusChip}" ToolTip="{Binding AiEngineStatusHint}">
                        <StackPanel>
                            <TextBlock Text="AI 엔진" Style="{StaticResource HmiStatusChipLabel}"/>
                            <TextBlock Text="{Binding AiEngineStatusText}" Foreground="{Binding AiEngineStatusBrush}"
                                       Style="{StaticResource HmiStatusChipValue}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#4C1D95" CornerRadius="8" Padding="12,6" Margin="0,0,8,0"
                            Visibility="{Binding MaintenanceBannerVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding MaintenanceBannerText}" Foreground="#EDE9FE" FontWeight="SemiBold" FontSize="12"/>
                    </Border>
                    <Button x:Name="BtnSimAllow" Content="{Binding SimAllowButtonText}"
                            Style="{StaticResource HmiToolbarButton}" Margin="0,0,0,0"
                            Click="BtnSimAllow_Click"
                            ToolTip="TwinCAT 없을 때 데모(가상 센서·TM 이송·로직 확인). 연결 시 실데이터 우선."/>
                    <Button x:Name="BtnDemoGuide" Content="데모 가이드" Style="{StaticResource HmiToolbarButton}"
                            Click="BtnDemoGuide_Click" ToolTip="3분 발표·검증 순서"/>
                    <Button x:Name="BtnDemoScenario" Content="데모 진행" Style="{StaticResource HmiToolbarButton}"
                            Click="BtnDemoScenario_Click" ToolTip="시뮬 허용·Start·검증 로그 자동 (약 10초)"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- ALARM / WARNING 전폭 배너 -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" CornerRadius="8" Padding="14,10" Margin="0,0,0,10"
                Background="{Binding SafetyBannerBrush}"
                Visibility="{Binding SafetyBannerVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding SafetyBannerText}" Foreground="White" FontWeight="Bold" FontSize="14"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- Left: Equipment schematic (시뮬 영역 최대화) -->
        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource HmiCard}" Margin="0,0,10,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource HmiCardHeader}">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="도식 확대" Style="{StaticResource HmiToolbarButton}" Margin="0,0,4,0"
                                    Click="BtnPopoutEquipment_Click" ToolTip="클러스터 도식만 전체 화면 (TM 진단은 별도)"/>
                            <Button Content="TM·스케줄" Style="{StaticResource HmiToolbarButton}" Margin="0,0,4,0"
                                    Click="BtnPopoutDiagnostics_Click" ToolTip="듀얼블레이드·HOLD·파이프라인·웨이퍼 타임라인"/>
                            <Button Content="센서 패널" Style="{StaticResource HmiToolbarButton}"
                                    Click="BtnPopoutSensors_Click" ToolTip="실측/데모 센서·스파크라인·Load Lock 접촉"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="장비 도식" Style="{StaticResource HmiCardTitle}"/>
                            <TextBlock Text="가상 TM · TM·스케줄·센서는 상단 버튼" Style="{StaticResource HmiCardSubtitle}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <eq:EquipmentSchematicControl Grid.Row="1" DataContext="{Binding Equipment}"
                                              VerticalAlignment="Stretch" Margin="8,4,8,8"/>
            </Grid>
        </Border>

        <!-- Center: 인터락·공정 요약 (상세는 분리 창) -->
        <Border Grid.Row="2" Grid.Column="1" Margin="0,0,10,12">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource HmiCard}">
                    <Setter Property="BorderBrush" Value="{StaticResource HmiBorderBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding InterlockPanelCritical}" Value="True">
                            <Setter Property="BorderBrush" Value="#DC2626"/>
                            <Setter Property="BorderThickness" Value="3"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource HmiCardHeader}">
                    <DockPanel LastChildFill="False">
                        <Button DockPanel.Dock="Right" Content="인터락·AI" Style="{StaticResource HmiToolbarButton}"
                                Click="BtnPopoutInterlock_Click" ToolTip="레시피·인터락 전체·AI 근거·모듈 상태"/>
                        <StackPanel>
                            <TextBlock Text="인터락 · 공정" Style="{StaticResource HmiCardTitle}"/>
                            <TextBlock Text="요약 + AI 전문 · 상세는 분리 창" Style="{StaticResource HmiCardSubtitle}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="10,8,10,10">
                    <controls:InterlockCompactControl x:Name="EmbeddedInterlock" DataContext="{Binding}"
                                                      OpenDetailRequested="EmbeddedInterlock_OpenDetailRequested"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Right: 제어 (컴팩트 · 전체는 분리 창) -->
        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource HmiCard}" Margin="0,0,0,12" VerticalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource HmiCardHeader}">
                    <DockPanel LastChildFill="False">
                        <Button DockPanel.Dock="Right" Content="제어 패널" Style="{StaticResource HmiToolbarButton}"
                                Click="BtnPopoutControl_Click" ToolTip="램프·Start/Stop·Reset·Maint 전체 크기"/>
                        <StackPanel>
                            <TextBlock Text="제어" Style="{StaticResource HmiCardTitle}"/>
                            <TextBlock Text="램프 · 조작" Style="{StaticResource HmiCardSubtitle}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <controls:ProcessControlPanelControl x:Name="EmbeddedProcessPanel" Grid.Row="1"
                    DataContext="{Binding}" CompactMode="True" VerticalAlignment="Stretch"
                    Margin="8,8,8,10"/>
            </Grid>
        </Border>

        <!-- Log strip -->
        <Border Grid.Row="3" Grid.ColumnSpan="3" Style="{StaticResource HmiCard}" Margin="0,0,0,8" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource HmiCardHeader}" CornerRadius="10,10,0,0">
                    <TextBlock Text="운영 로그" Style="{StaticResource HmiCardTitle}"/>
                </Border>
                <ListBox Grid.Row="1" ItemsSource="{Binding LogLines}" Style="{StaticResource HmiLogList}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="8,4,8,8"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="4" Grid.ColumnSpan="3" Foreground="{StaticResource HmiTextSecondaryBrush}" FontSize="11"
                   Text="현장 PC: WPF + EtherCAT + Flask  ·  모니터링: http://&lt;현장PC IP&gt;:5000 (조회 전용)"/>
    </Grid>
</Window>
