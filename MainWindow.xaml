<Window x:Class="etch_ui.MainWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

        xmlns:controls="clr-namespace:etch_ui.Controls"
        xmlns:eq="clr-namespace:etch_ui.Equipment.Views"

        mc:Ignorable="d"

        Title="Etch Load Lock HMI"

        Height="860"

        Width="1280"

        MinHeight="780"

        MinWidth="1180">
    <Window.Resources>
        <Style x:Key="SensorLabelText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SensorValueText" TargetType="TextBlock"/>
        <Style x:Key="SensorHintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>
    <Grid Margin="12">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="2*"/>

            <ColumnDefinition Width="2*"/>

            <ColumnDefinition Width="3*"/>

        </Grid.ColumnDefinitions>



        <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#1F2937" CornerRadius="8" Padding="12" Margin="0,0,0,10">

            <DockPanel>

                <TextBlock Text="플라즈마 식각 장비 Load Lock/챔버 상태 관리 HMI"

                           Foreground="White"

                           FontSize="18"

                           FontWeight="Bold"

                           DockPanel.Dock="Left"/>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">

                    <TextBlock Text="사용자: " Foreground="White" VerticalAlignment="Center"/>

                    <TextBlock Text="{Binding CurrentUserText}" Foreground="#D1FAE5" FontWeight="Bold" VerticalAlignment="Center"/>

                    <Button x:Name="BtnUserManage" Content="사용자 관리" Margin="8,0,8,0" Padding="8,2" Click="BtnUserManage_Click"

                            Visibility="{Binding ShowUserManage, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <Button x:Name="BtnLogout" Content="로그아웃" Margin="0,0,14,0" Padding="8,2" Click="BtnLogout_Click"/>

                    <TextBlock Text="Flask: " Foreground="White" VerticalAlignment="Center" Margin="8,0,0,0"/>

                    <TextBlock Text="{Binding FlaskStatusText}" Foreground="{Binding FlaskStatusBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>

                    <Button x:Name="BtnOpenFlask" Content="대시보드" Margin="0,0,14,0" Padding="8,2" VerticalAlignment="Center"
                            Click="BtnOpenFlask_Click"
                            ToolTip="Flask 웹 대시보드를 브라우저에서 엽니다."/>

                    <TextBlock Text="EtherCAT: " Foreground="White" VerticalAlignment="Center"/>

                    <TextBlock Text="{Binding PlcStatusText}" Foreground="{Binding PlcStatusBrush}" FontWeight="Bold" VerticalAlignment="Center"/>

                    <Button x:Name="BtnSimAllow" Content="{Binding SimAllowButtonText}" Margin="10,0,0,0" Padding="8,2" VerticalAlignment="Center"

                            Click="BtnSimAllow_Click"

                            ToolTip="켜두면 EtherCAT 끊김 시 데모용 시뮬 센서로 대체합니다. 실기만 사용할 때는 끄세요."/>

                    <TextBlock Text="   마지막 갱신: " Foreground="White" VerticalAlignment="Center"/>

                    <TextBlock Text="{Binding LastUpdateText}" Foreground="#D1D5DB" VerticalAlignment="Center"/>

                    <TextBlock Text="  | 데이터: " Foreground="White" VerticalAlignment="Center" Margin="8,0,0,0"/>

                    <TextBlock Text="{Binding DataQualityText}" Foreground="{Binding DataQualityBrush}" VerticalAlignment="Center"

                               ToolTip="EtherCAT(TwinCAT ADS) 마지막 성공 읽기 또는 시뮬/오프라인 표시"/>

                </StackPanel>

            </DockPanel>

        </Border>



        <GroupBox Grid.Row="1" Grid.Column="0" Header="장비 상태" Margin="0,0,10,10" Padding="10">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

            <eq:EquipmentSchematicControl Grid.Row="0" DataContext="{Binding Equipment}" Margin="0,0,0,8"/>

            <StackPanel Grid.Row="1">

                <TextBlock Text="현재 상태" FontWeight="SemiBold" Margin="0,0,0,6"/>

                <TextBlock Text="{Binding StateText}" FontSize="28" FontWeight="Bold" Foreground="{Binding StateBrush}"/>

                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">

                    <TextBlock Text="알람: " FontWeight="SemiBold" VerticalAlignment="Center"/>

                    <TextBlock Text="{Binding AlarmCodeText}" Foreground="{Binding AlarmCodeBrush}" VerticalAlignment="Center"/>

                </StackPanel>

                <TextBlock Text="{Binding AlarmDetailText}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12"

                           Foreground="{Binding AlarmDetailBrush}" LineHeight="18"/>



                <UniformGrid Columns="2" Margin="0,12,0,0">

                    <StackPanel Margin="0,0,12,8">

                        <TextBlock Text="온도(℃)" Style="{StaticResource SensorLabelText}"/>

                        <TextBlock Text="{Binding TemperatureText}" Style="{StaticResource SensorValueText}"/>

                    </StackPanel>

                    <StackPanel Margin="0,0,0,8">

                        <TextBlock Text="습도(%)" Style="{StaticResource SensorLabelText}"/>

                        <TextBlock Text="{Binding HumidityText}" Style="{StaticResource SensorValueText}"/>

                    </StackPanel>

                    <StackPanel Margin="0,0,12,8">

                        <TextBlock Text="압력(mTorr)" Style="{StaticResource SensorLabelText}"/>

                        <TextBlock Text="{Binding PressureText}" Style="{StaticResource SensorValueText}"/>

                    </StackPanel>

                    <StackPanel Margin="0,0,0,8">

                        <TextBlock Text="진동(g)" Style="{StaticResource SensorLabelText}"/>

                        <TextBlock Text="{Binding VibrationText}" Style="{StaticResource SensorValueText}"/>

                    </StackPanel>

                </UniformGrid>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">

                    <TextBlock Text="도어 (유도형): " FontWeight="SemiBold"/>

                    <TextBlock Text="{Binding AccessText}" Foreground="{Binding AccessBrush}" FontWeight="Bold"/>

                </StackPanel>

            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,8,0,0" VerticalAlignment="Top">
                <TextBlock Text="실시간 추세 (약 72초)" FontWeight="SemiBold" FontSize="11" Foreground="#374151"/>
                <Grid Height="84" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <controls:SparklineControl Grid.Column="0"
                        Title="압력 mTorr"
                        Values="{Binding PressureSparkValues}"
                        YMin="{Binding PressureSparkYMin}"
                        YMax="{Binding PressureSparkYMax}"
                        Stroke="#2563EB"/>
                    <controls:SparklineControl Grid.Column="2"
                        Title="진동 g"
                        Values="{Binding VibrationSparkValues}"
                        YMin="{Binding VibrationSparkYMin}"
                        YMax="{Binding VibrationSparkYMax}"
                        Stroke="#7C3AED"/>
                </Grid>
                <TextBlock Text="센서 정상 대역" FontWeight="SemiBold" FontSize="11" Foreground="#374151" Margin="0,10,0,6"/>
                <UniformGrid Columns="2">
                    <controls:SensorRangeBar Title="압력 mTorr"
                        Value="{Binding SensorPressureValue}"
                        RangeMin="{Binding SensorPressureRangeMin}"
                        RangeMax="{Binding SensorPressureRangeMax}"
                        ScaleMin="0"
                        ScaleMax="{Binding SensorPressureScaleMax}"
                        Unit="mTorr"/>
                    <controls:SensorRangeBar Title="진동 g"
                        Value="{Binding SensorVibrationValue}"
                        RangeMin="0"
                        RangeMax="{Binding SensorVibrationRangeMax}"
                        ScaleMin="0"
                        ScaleMax="{Binding SensorVibrationScaleMax}"
                        Unit="g"/>
                    <controls:SensorRangeBar Title="온도 ℃"
                        Value="{Binding SensorTempValue}"
                        RangeMin="{Binding SensorTempRangeMin}"
                        RangeMax="{Binding SensorTempRangeMax}"
                        ScaleMin="{Binding SensorTempScaleMin}"
                        ScaleMax="{Binding SensorTempScaleMax}"
                        Unit="℃"/>
                    <controls:SensorRangeBar Title="습도 %"
                        Value="{Binding SensorHumiValue}"
                        RangeMin="{Binding SensorHumiRangeMin}"
                        RangeMax="{Binding SensorHumiRangeMax}"
                        ScaleMin="0"
                        ScaleMax="{Binding SensorHumiScaleMax}"
                        Unit="%"/>
                </UniformGrid>
            </StackPanel>
            </Grid>

        </GroupBox>



        <GroupBox Grid.Row="1" Grid.Column="1" Header="인터락 / 공정 위치" Margin="0,0,10,10" Padding="10">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">

                <TextBlock Text="인터락 (appsettings.json)" FontWeight="SemiBold" Margin="0,0,0,6"/>

                <TextBlock Text="{Binding InterlockPlcText}" Margin="0,0,0,6" FontWeight="SemiBold" Foreground="{Binding InterlockPlcBrush}"/>

                <TextBlock Text="{Binding InterlockPressureText}" Margin="0,0,0,6" FontWeight="SemiBold" Foreground="{Binding InterlockPressureBrush}"/>

                <TextBlock Text="{Binding InterlockVibText}" Margin="0,0,0,6" FontWeight="SemiBold" Foreground="{Binding InterlockVibBrush}"/>

                <TextBlock Text="{Binding InterlockAccessText}" Margin="0,0,0,6" FontWeight="SemiBold" Foreground="{Binding InterlockAccessBrush}"/>

                <TextBlock Text="{Binding InterlockTempText}" Margin="0,0,0,6" FontWeight="SemiBold" Foreground="{Binding InterlockTempBrush}"/>

                <TextBlock Text="{Binding InterlockHumiText}" Margin="0,0,0,10" FontWeight="SemiBold" Foreground="{Binding InterlockHumiBrush}"/>



                <Border Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" Padding="8" CornerRadius="6">

                    <StackPanel>

                        <TextBlock Text="판정 결과" FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding InterlockResultText}" Foreground="{Binding InterlockResultBrush}" Margin="0,4,0,0" FontWeight="SemiBold"/>

                    </StackPanel>

                </Border>

            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,10,0,0" VerticalAlignment="Top">
                <TextBlock Text="공정 스텝" FontWeight="SemiBold" FontSize="11" Foreground="#374151" Margin="0,0,0,6"/>
                <controls:ProcessStepLadderControl
                    ActiveStepIndex="{Binding ProcessStepIndex}"
                    IsWarningStep="{Binding ProcessStepWarning}"/>
            </StackPanel>
            </Grid>

        </GroupBox>



        <GroupBox Grid.Row="1" Grid.Column="2" Header="상태 램프 / 제어" Margin="0,0,0,10" Padding="10">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>



                <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,10">

                    <Border CornerRadius="6" Margin="4" Padding="8"

                            Background="{Binding LampReadyOn, Converter={StaticResource LampBrush}, ConverterParameter=Blue}">

                        <TextBlock Text="준비" HorizontalAlignment="Center"/>

                    </Border>

                    <Border CornerRadius="6" Margin="4" Padding="8"

                            Background="{Binding LampRunOn, Converter={StaticResource LampBrush}, ConverterParameter=Green}">

                        <TextBlock Text="운전" HorizontalAlignment="Center"/>

                    </Border>

                    <Border CornerRadius="6" Margin="4" Padding="8"

                            Background="{Binding LampWarnOn, Converter={StaticResource LampBrush}, ConverterParameter=Gold}">

                        <TextBlock Text="경고" HorizontalAlignment="Center"/>

                    </Border>

                    <Border CornerRadius="6" Margin="4" Padding="8"

                            Background="{Binding LampAlarmOn, Converter={StaticResource LampBrush}, ConverterParameter=Red}">

                        <TextBlock Text="알람" HorizontalAlignment="Center"/>

                    </Border>

                </UniformGrid>



                <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,10">

                    <Button x:Name="BtnStart" Content="시작" Margin="4" Padding="8" Click="BtnStart_Click"

                            IsEnabled="{Binding CanStart}"

                            ToolTip="{Binding StartButtonToolTip}"/>

                    <Button x:Name="BtnStop" Content="정지" Margin="4" Padding="8" Click="BtnStop_Click"

                            IsEnabled="{Binding CanStop}"

                            ToolTip="공정을 정지합니다."/>

                    <Button x:Name="BtnReset" Content="알람 리셋" Margin="4" Padding="8" Click="BtnReset_Click"

                            IsEnabled="{Binding CanReset}"

                            ToolTip="알람 상태를 해제합니다. (관리자)"/>

                    <Button x:Name="BtnMaint" Content="유지보수" Margin="4" Padding="8" Click="BtnMaint_Click"

                            IsEnabled="{Binding CanMaint}"

                            ToolTip="유지보수 모드를 전환합니다. (관리자)"/>

                </UniformGrid>



                <GroupBox Grid.Row="2" Header="알람 / 로그(최근)" Padding="8">

                    <ListBox ItemsSource="{Binding LogLines}"/>

                </GroupBox>

            </Grid>

        </GroupBox>



        <TextBlock Grid.Row="2" Grid.ColumnSpan="3"

                   Foreground="#6B7280"

                   Text="현장 PC: WPF+EtherCAT+Flask 서버 · 모니터링 PC: 브라우저로 http://&lt;현장PC IP&gt;:5000 (조회 전용)"/>

    </Grid>

</Window>


