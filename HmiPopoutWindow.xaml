<Window x:Class="etch_ui.HmiPopoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MinHeight="360"
        MinWidth="480"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource HmiFont}"
        Background="{StaticResource HmiCanvasBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TxtSubtitle" Style="{StaticResource HmiCardSubtitle}" Margin="0,0,0,8"/>
        <Border Grid.Row="1" Style="{StaticResource HmiCard}" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ContentControl x:Name="Host"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
