<Window x:Class="etch_ui.PasswordChangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="비밀번호 변경"
        Height="420"
        Width="440"
        MinHeight="380"
        MinWidth="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontFamily="{StaticResource HmiFont}"
        Background="{StaticResource HmiCanvasBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="TxtTitle" Text="비밀번호 변경" FontSize="20" FontWeight="Bold" Foreground="{StaticResource HmiTextPrimaryBrush}"/>
            <TextBlock x:Name="TxtSubtitle" Text="본인 계정 비밀번호를 변경합니다."
                       Style="{StaticResource HmiCardSubtitle}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource HmiCard}" Padding="16">
            <StackPanel>
                <StackPanel x:Name="PanelCurrent">
                    <TextBlock Text="현재 비밀번호" Style="{StaticResource HmiCaption}" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="TxtCurrent" Height="34" VerticalContentAlignment="Center" Margin="0,0,0,12"/>
                </StackPanel>
                <TextBlock Text="새 비밀번호" Style="{StaticResource HmiCaption}" Margin="0,0,0,6"/>
                <PasswordBox x:Name="TxtNew" Height="34" VerticalContentAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="새 비밀번호 확인" Style="{StaticResource HmiCaption}" Margin="0,0,0,6"/>
                <PasswordBox x:Name="TxtConfirm" Height="34" VerticalContentAlignment="Center"/>
                <TextBlock x:Name="TxtMsg" Foreground="#DC2626" TextWrapping="Wrap" MinHeight="20" Margin="0,12,0,0" FontSize="13"/>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="저장" Style="{StaticResource HmiPrimaryButton}" Margin="0,0,8,0" Click="BtnSave_Click" IsDefault="True"/>
            <Button Content="취소" Style="{StaticResource HmiSecondaryButton}" IsCancel="True" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
