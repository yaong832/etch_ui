<Window x:Class="etch_ui.PasswordChangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="비밀번호 변경"
        SizeToContent="Height"
        Width="460"
        MinWidth="400"
        MaxHeight="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontFamily="{StaticResource HmiFont}"
        Background="{StaticResource HmiCanvasBrush}">
    <Grid Margin="24,24,24,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="TxtTitle" Text="비밀번호 변경" FontSize="20" FontWeight="Bold" Foreground="{StaticResource HmiTextPrimaryBrush}"/>
            <TextBlock x:Name="TxtSubtitle" Text="본인 계정 비밀번호를 변경합니다."
                       Style="{StaticResource HmiCardSubtitle}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      MaxHeight="420">
            <Border Style="{StaticResource HmiCard}" Padding="16">
                <StackPanel>
                    <StackPanel x:Name="PanelCurrent">
                        <TextBlock Text="현재 비밀번호" Style="{StaticResource HmiCaption}" Margin="0,0,0,6"/>
                        <PasswordBox x:Name="TxtCurrent" Height="34" VerticalContentAlignment="Center" Margin="0,0,0,12"/>
                    </StackPanel>
                    <TextBlock Text="새 비밀번호" Style="{StaticResource HmiCaption}" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="TxtNew" Height="34" VerticalContentAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="새 비밀번호 확인" Style="{StaticResource HmiCaption}" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="TxtConfirm" Height="34" VerticalContentAlignment="Center"/>
                    <TextBlock Text="• 최소 8자, 영문과 숫자 포함"
                               Style="{StaticResource HmiCardSubtitle}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    <TextBlock x:Name="TxtMsg" Foreground="#DC2626" TextWrapping="Wrap" MinHeight="20" Margin="0,12,0,0" FontSize="13"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="저장" Style="{StaticResource HmiPrimaryButton}" Margin="0,0,8,0" Click="BtnSave_Click" IsDefault="True" MinWidth="88"/>
            <Button Content="취소" Style="{StaticResource HmiSecondaryButton}" IsCancel="True" Click="BtnCancel_Click" MinWidth="88"/>
        </StackPanel>
    </Grid>
</Window>
